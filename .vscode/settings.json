{
  "yaml.schemas": {
    "./schemas/enterprise.schema.json": "config/enterprise.yaml",
    "./schemas/org.schema.json": [
      "config/orgs/*/org.yaml",
      "candidates/*/org.yaml"
    ],
    "./schemas/teams.schema.json": [
      "config/orgs/*/teams.yaml",
      "candidates/*/teams.yaml"
    ],
    "./schemas/domain-repos.schema.json": [
      "config/orgs/*/repos/*.yaml",
      "candidates/*/repos/*.yaml",
      ".agents/skills/onboard-project/examples/*.yaml"
    ]
  },
  "files.associations": {
    "*.rego": "rego",
    "*.tf": "opentofu"
  },
  "recommendations": [
    "hashicorp.terraform",
    "redhat.vscode-yaml",
    "github.vscode-github-actions",
    "github.vscode-pull-request-github",
    "ms-azuretools.vscode-docker",
    "ms-python.python",
    "ms-python.vscode-pylance",
    "yzhang.markdown-all-in-one"
  ]
}
