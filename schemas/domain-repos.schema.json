{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://taswater.internal/schemas/github-domain-repos.schema.json",
  "title": "GitHub Domain Repository Group & Archetype Dials Schema",
  "description": "Validates domain-grouped repository files in config/orgs/<org>/repos/<domain>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "defaults",
    "repositories"
  ],
  "properties": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "description",
        "organization"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,48}$",
          "description": "Domain slug key matching the YAML filename (<key>.yaml)."
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "Human-readable name of this business domain, product group, or service area."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Summary of the repositories managed in this domain file."
        },
        "organization": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "description": "Owning GitHub Organization slug (must match parent directory config/orgs/<organization>/)."
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shared defaults inherited by every repository in this domain file unless overridden on the repository.",
      "required": [
        "archetype",
        "team_access"
      ],
      "properties": {
        "archetype": {
          "type": "string",
          "enum": [
            "standard-microservice",
            "regulated-workload",
            "shared-library",
            "sandbox"
          ],
          "description": "Default governance archetype for repositories in this domain."
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "internal"
          ],
          "description": "Optional default visibility override ('private' or 'internal')."
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
          },
          "default": [],
          "description": "Default GitHub repository topics applied across this domain."
        },
        "team_access": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "team",
              "permission"
            ],
            "properties": {
              "team": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
                "description": "Team slug defined in the organization's teams.yaml."
              },
              "permission": {
                "type": "string",
                "enum": [
                  "pull",
                  "triage",
                  "push",
                  "maintain"
                ],
                "description": "GitHub repository role. Note: 'admin' is blocked by Tier 1 baseline so branch rulesets cannot be bypassed."
              }
            }
          }
        },
        "environments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "require_approval"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-_]{1,32}$"
              },
              "description": {
                "type": "string"
              },
              "require_approval": {
                "type": "boolean"
              },
              "approver_teams": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
                },
                "description": "Team slugs from teams.yaml required to approve deployments when require_approval is true."
              },
              "deployment_branch_policy": {
                "type": "string",
                "enum": [
                  "protected_branches",
                  "all_branches"
                ],
                "default": "protected_branches"
              }
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(\\.github(-private)?|[a-zA-Z0-9][a-zA-Z0-9-_.]{1,99})$",
            "description": "Repository name within the GitHub Organization (including GitHub's special .github / .github-private repositories)."
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Clear description of the repository's purpose."
          },
          "archetype": {
            "type": "string",
            "enum": [
              "standard-microservice",
              "regulated-workload",
              "shared-library",
              "sandbox"
            ],
            "description": "Optional per-repository archetype override (defaults to domain.defaults.archetype)."
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "internal"
            ],
            "description": "Optional per-repository visibility override ('private' or 'internal'; 'public' is blocked by Tier 1)."
          },
          "default_branch": {
            "type": "string",
            "enum": [
              "main"
            ],
            "default": "main"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
            },
            "description": "Additional or overriding topics for this repository."
          },
          "features": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional per-repository overrides for GitHub repository features.",
            "properties": {
              "has_issues": {
                "type": "boolean"
              },
              "has_wiki": {
                "type": "boolean"
              },
              "has_discussions": {
                "type": "boolean"
              },
              "has_projects": {
                "type": "boolean"
              }
            }
          },
          "merge_strategies": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional per-repository overrides for allowed PR merge strategies.",
            "properties": {
              "allow_squash_merge": {
                "type": "boolean"
              },
              "allow_merge_commit": {
                "type": "boolean"
              },
              "allow_rebase_merge": {
                "type": "boolean"
              },
              "allow_auto_merge": {
                "type": "boolean"
              },
              "delete_branch_on_merge": {
                "type": "boolean"
              }
            }
          },
          "branch_protection": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional per-repository overrides for Tier 2 default branch protection / ruleset dials.",
            "properties": {
              "min_reviewers": {
                "type": "integer",
                "minimum": 2,
                "maximum": 5,
                "description": "Dial: Minimum required approving reviews on main (2..5; regulated-workload requires >= 3)."
              },
              "dismiss_stale_reviews": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "require_code_owner_reviews": {
                "type": "boolean"
              },
              "require_last_push_approval": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "require_conversation_resolution": {
                "type": "boolean"
              },
              "require_signed_commits": {
                "type": "boolean"
              },
              "require_linear_history": {
                "type": "boolean"
              }
            }
          },
          "security": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional per-repository overrides for GitHub Advanced Security & Dependabot toggles.",
            "properties": {
              "dependabot_alerts": {
                "type": "boolean"
              },
              "dependabot_security_updates": {
                "type": "boolean"
              },
              "secret_scanning": {
                "type": "boolean"
              },
              "secret_scanning_push_protection": {
                "type": "boolean"
              },
              "code_scanning_default_setup": {
                "type": "boolean"
              }
            }
          },
          "jira_autolink": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional Jira autolink configuration. Its presence enables one Jira autolink for this repository.",
            "required": [
              "project_key"
            ],
            "properties": {
              "project_key": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]{1,9}$",
                "description": "Jira project key (2-10 uppercase letters/digits); used as the autolink prefix."
              },
              "browse_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^?#\\s]+$",
                "description": "Optional HTTPS Jira browse URL prefix overriding enterprise_defaults.jira_autolink.browse_url."
              }
            }
          },
          "required_status_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            },
            "description": "Optional CI status check contexts required to pass before merging to main."
          },
          "team_access": {
            "type": "array",
            "description": "Optional per-repository team access list (replaces or extends domain defaults).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "team",
                "permission"
              ],
              "properties": {
                "team": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
                },
                "permission": {
                  "type": "string",
                  "enum": [
                    "pull",
                    "triage",
                    "push",
                    "maintain"
                  ]
                }
              }
            }
          },
          "codeowners_teams": {
            "type": "array",
            "description": "Optional path-specific CODEOWNERS review rules mapping paths to organization team slugs.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "teams"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/.*"
                },
                "teams": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
                  }
                }
              }
            }
          },
          "environments": {
            "type": "array",
            "description": "Optional per-repository deployment environments override (defaults to domain.defaults.environments).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "require_approval"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-_]{1,32}$"
                },
                "description": {
                  "type": "string"
                },
                "require_approval": {
                  "type": "boolean"
                },
                "approver_teams": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
                  }
                },
                "deployment_branch_policy": {
                  "type": "string",
                  "enum": [
                    "protected_branches",
                    "all_branches"
                  ],
                  "default": "protected_branches"
                }
              }
            }
          },
          "environment_variables": {
            "type": "object",
            "description": "Non-sensitive repository Actions variables ONLY. Secret key names are rejected by policy (use GitHub Secrets / Azure Key Vault OIDC instead).",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
