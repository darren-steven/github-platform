{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contoso.internal/schemas/identity-bootstrap.schema.json",
  "title": "OpenTofu Identity Bootstrap Configuration",
  "description": "Privileged Entra groups and Azure DevOps associations for the separate identity bootstrap environment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_group", "apply_group", "plan_project_names"],
  "properties": {
    "plan_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "description", "member_object_ids", "owner_object_ids"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1024
        },
        "member_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "owner_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        }
      }
    },
    "apply_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "description", "eligible_member_object_ids"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1024
        },
        "eligible_member_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        }
      }
    },
    "plan_project_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
